# Supabase（前端）
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# 本地开发：Vite 代理 recommend/chat → Friday（配置后无需 supabase deploy）
# 个人租户 AppId 勿提交到 Git；不要加 VITE_ 前缀（避免暴露到浏览器）
FRIDAY_APP_ID=
FRIDAY_BASE_URL=https://aigc.sankuai.com/v1/openai/native
FRIDAY_MODEL=gpt-4o-mini
# Agent 场景可选（文档 Mt-* header）
FRIDAY_MT_AGENT_ID=
FRIDAY_MT_USER_ID=weekendmiao-demo

# 行程规划：server=走 plan 接口（默认）；client=浏览器内跑 DAG（调试）
# VITE_PLAN_MODE=server

# Edge Functions：Lovable Gemini 兜底（未配置 FRIDAY_APP_ID 时使用）
LOVABLE_API_KEY=
